  Civil Engineering (Building 72),
  90.0,
  ,
  ,
  ,
  ,
  ,
  ;

! source: EnergyPlus default (schema)
Timestep,
  6;

! source: derived; the gbXML polygons are counterclockwise seen from outside, in absolute coordinates
GlobalGeometryRules,
  UpperLeftCorner,
  Counterclockwise,
  World;


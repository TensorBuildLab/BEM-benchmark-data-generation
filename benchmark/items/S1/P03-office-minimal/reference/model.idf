  NaturalGas:Facility,
  Hourly;

! source: standard set
Output:Variable,
  *,
  Site Outdoor Air Drybulb Temperature,
  Hourly;

! source: standard set
Output:Variable,
  *,
  Zone Mean Air Temperature,
  Hourly;

! source: standard set
Output:Variable,
  *,
  Zone Air Relative Humidity,
  Hourly;

! source: standard set
Output:Variable,
  *,
  Zone Air System Sensible Heating Energy,
  Hourly;

! source: standard set
Output:Variable,
  *,
  Zone Air System Sensible Cooling Energy,
  Hourly;

! source: standard set

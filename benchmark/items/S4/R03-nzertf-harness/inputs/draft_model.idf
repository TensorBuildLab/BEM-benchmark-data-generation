!-Generator gbxml2idf
!-Option SortedOrder

! IDF written by gbxml2idf 0.5 (M4) (no date here: the same input gives the same text)
! gbXML: output10.assembled.gbxml (sha256 c4b69e44b9ab9d032b7f99438d6cd07a264fe87c884960c7819297a024cb35ab)
! notes: output10.pipeline_notes.xml
! every object carries its source: stated | derived | assumed | user | reference | EnergyPlus default

! ---------- Version ----------------------------------------

! source: derived; EnergyPlus 23.1 (the schema in use)
Version,
  23.1;  !- Version Identifier

! ---------- Simulation parameters ----------------------------------------

! source: derived; sizing only when an HVAC fragment with sizing objects is inserted (zone and system sizing; plant sizing only when it has Sizing:Plant); the weather-file run period is the simulation
SimulationControl,
  Yes,  !- Do Zone Sizing Calculation
  Yes,  !- Do System Sizing Calculation
  No,  !- Do Plant Sizing Calculation
  Yes,  !- Run Simulation for Sizing Periods
  Yes,  !- Run Simulation for Weather File Run Periods
  ,  !- Do HVAC Sizing Simulation for Sizing Periods
  ;  !- Maximum Number of HVAC Sizing Simulation Passes

! source: stated; gbXML: bldg-1; North Axis = CADModelAzimuth of the gbXML; terrain, convergence and warm-up fields are left blank = EnergyPlus defaults
Building,
  Single-family house of nzertf-inputs.xlsx,  !- Name
  0.0,  !- North Axis {deg}
  ,  !- Terrain
  ,  !- Loads Convergence Tolerance Value {W}
  ,  !- Temperature Convergence Tolerance Value {deltaC}
  ,  !- Solar Distribution
  ,  !- Maximum Number of Warmup Days
  ;  !- Minimum Number of Warmup Days

! source: user; mid file
Timestep,
  60;  !- Number of Timesteps per Hour

! source: EnergyPlus defaults (schema), written explicitly by the mid key explicit_default_objects; every field is blank: the model is the same as without the object
SurfaceConvectionAlgorithm:Inside,
  ;  !- Algorithm

! source: EnergyPlus defaults (schema), written explicitly by the mid key explicit_default_objects; every field is blank: the model is the same as without the object
SurfaceConvectionAlgorithm:Outside,
  ;  !- Algorithm

! source: EnergyPlus defaults (schema), written explicitly by the mid key explicit_default_objects; every field is blank: the model is the same as without the object
HeatBalanceAlgorithm,
  ;  !- Algorithm

! source: EnergyPlus defaults (schema), written explicitly by the mid key explicit_default_objects; every field is blank: the model is the same as without the object
ShadowCalculation,
  ;  !- Shading Calculation Method

! source: derived; the gbXML polygons are counterclockwise seen from outside, in absolute coordinates
GlobalGeometryRules,
  UpperLeftCorner,  !- Starting Vertex Position
  Counterclockwise,  !- Vertex Entry Direction
  World;  !- Coordinate System

! source: stated (notes RunPeriod); no year (typical weather); the start day is a Sunday as on 2012-01-01
RunPeriod,
  Run Period 1,  !- Name
  1,  !- Begin Month
  1,  !- Begin Day of Month
  ,  !- Begin Year
  12,  !- End Month
  31,  !- End Day of Month
  ,  !- End Year
  Sunday,  !- Day of Week for Start Day
  No,  !- Use Weather File Holidays and Special Days
  No,  !- Use Weather File Daylight Saving Period
  No;  !- Apply Weekend Holiday Rule

! source: user (mid daylight_saving: nzertf-inputs.xlsx rows 6-7: Daylight Saving Enabled True; Daylight Saving Period Mar 12 - Nov 5)
RunPeriodControl:DaylightSavingTime,
  March 12,  !- Start Date
  November 5;  !- End Date

! source: derived (notes Holidays); 2012-01-01
RunPeriodControl:SpecialDays,
  New Years Day,  !- Name
  1/1,  !- Start Date
  1,  !- Duration {days}
  Holiday;  !- Special Day Type

